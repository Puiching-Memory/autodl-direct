{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "autodl-direct",
  "version": "0.1.3",
  "description": "本地自建的 AutoDL 工具：直接调用官方 API 管理 Pro 实例，配合系统 SSH 运行 GPU 任务。",
  "author": {
    "name": "Puiching-Memory",
    "url": "https://github.com/Puiching-Memory"
  },
  "keywords": [
    "autodl",
    "gpu",
    "ssh"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "AutoDL Direct",
        "shortDescription": "直接管理 AutoDL GPU 实例",
        "longDescription": "在本机运行，直接访问 AutoDL 官方开发者 API。查询余额、Pro 实例和镜像，预览或执行创建、开关机及保存镜像；通过 Skill 配合系统 SSH 操作已有实例。由本地工作区自建，与 AutoDL 官方无隶属关系。",
        "developerName": "Puiching-Memory",
        "category": "Productivity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "defaultPrompt": "使用 AutoDL Direct 检查本机配置，并查询我的余额和 Pro 实例。",
        "brandColor": "#0F766E",
        "brandColorDark": "#2DD4BF",
        "composerIcon": "./assets/icon.svg",
        "composerIconDark": "./assets/icon-dark.svg",
        "logo": "./assets/logo.svg",
        "logoDark": "./assets/logo-dark.svg"
      }
    }
  },
  "repository": "https://github.com/Puiching-Memory/autodl-direct",
  "homepage": "https://github.com/Puiching-Memory/autodl-direct",
  "license": "MIT"
}
